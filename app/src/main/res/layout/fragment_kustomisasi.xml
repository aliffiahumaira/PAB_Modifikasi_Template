<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_porcelain"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Title Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kustomisasi Buket"
                    android:textColor="@color/primary_sage"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Langkah 2 dari 3 • Petale Atelier"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSaveDraft"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Simpan Draft"
                android:textColor="@color/primary_sage"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                app:strokeColor="@color/outline_variant" />
        </RelativeLayout>

        <!-- Live Sensory Preview Hero Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/surface_container_lowest"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp">

                    <ImageView
                        android:id="@+id/imgPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/surface_container_low"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_bouquet_peony"
                        android:contentDescription="Pratinjau Buket" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_margin="10dp"
                        android:background="@color/surface_container_lowest"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="🌿 Segar Hari Ini"
                        android:textColor="@color/primary_sage"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="10dp"
                        android:background="@color/black"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="Pratinjau Nyata"
                        android:textColor="@color/white"
                        android:textSize="10sp" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="KOLEKSI SIGNATURE"
                        android:textColor="@color/secondary_rose"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★ 4.9 (148 ulasan)"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPreviewTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Buket Peony Pastel Harmoni"
                    android:textColor="@color/on_surface_forest"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPreviewDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Kombinasi bunga premium dengan wrapping Kraft Earthy dan aksen pita Sage Green."
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp" />

                <!-- Specification Badges -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/badgeFlower"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@color/surface_container"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="🌸 Peony Pastel"
                        android:textColor="@color/primary_sage"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/badgeWrap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@color/surface_container_high"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="Kraft Earthy"
                        android:textColor="@color/on_surface_forest"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/badgeRibbon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/surface_container_high"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="Pita Sage Green"
                        android:textColor="@color/on_surface_forest"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- STEP 1: Pilih Bunga Inti -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_container_lowest"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Pilih Bunga Inti (Wajib)"
                    android:textColor="@color/on_surface_forest"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"
                    android:text="Tentukan bunga utama sebagai pusat pesona buket Anda."
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/rgFlowers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbPeony"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:padding="8dp"
                        android:text="🌸 Peony Pastel — Rp 285.000"
                        android:textColor="@color/on_surface_forest"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbRose"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="🌹 Mawar Merah — Rp 260.000"
                        android:textColor="@color/on_surface_forest"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbSunflower"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="🌻 Bunga Matahari — Rp 240.000"
                        android:textColor="@color/on_surface_forest"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbBabyBreath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="☁️ Baby Breath — Rp 210.000"
                        android:textColor="@color/on_surface_forest"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbLily"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="🌺 Lily Casablanca — Rp 320.000"
                        android:textColor="@color/on_surface_forest"
                        android:textSize="14sp" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- STEP 2: Kertas Pembungkus -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_container_lowest"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Kertas Pembungkus (Wrapping Paper)"
                    android:textColor="@color/on_surface_forest"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"
                    android:text="Sentuhan kertas floral import yang membungkus keindahan tangkai."
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/rgWrapping"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbKraft"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:padding="8dp"
                        android:text="Kraft Earthy (Termasuk)"
                        android:textColor="@color/on_surface_forest"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbSoftBlush"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="Soft Blush Pink (+Rp 15.000)"
                        android:textColor="@color/on_surface_forest"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbDarkOlive"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="Dark Olive (+Rp 15.000)"
                        android:textColor="@color/on_surface_forest"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbWhiteSatin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="Pure White Satin (+Rp 20.000)"
                        android:textColor="@color/on_surface_forest"
                        android:textSize="14sp" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- STEP 3: Pita Bouquet -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_container_lowest"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Pilihan Pita Bouquet"
                    android:textColor="@color/on_surface_forest"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgRibbon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbRibbonSage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:padding="8dp"
                        android:text="Pita Sage Green (Termasuk)"
                        android:textColor="@color/on_surface_forest"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbRibbonPink"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="Pita Soft Pink Silk (+Rp 10.000)"
                        android:textColor="@color/on_surface_forest"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbRibbonGold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="Pita Gold Metallic (+Rp 15.000)"
                        android:textColor="@color/on_surface_forest"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbRibbonJute"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="Pita Natural Jute (+Rp 5.000)"
                        android:textColor="@color/on_surface_forest"
                        android:textSize="14sp" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- STEP 4: Pesan Kartu Ucapan -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/surface_container_lowest"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. Pesan Kartu Ucapan Handwritten"
                    android:textColor="@color/on_surface_forest"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etCardMessage"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/surface_container_low"
                    android:gravity="top|start"
                    android:hint="Tulis pesan manis Anda di sini... (Contoh: Happy Anniversary, My Love!)"
                    android:padding="12dp"
                    android:textColor="@color/on_surface_forest"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Bottom Action Bar for Total Price & Add to Cart -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_container_lowest"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Estimasi Price"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvTotalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 285.000"
                    android:textColor="@color/primary_sage"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAddToCartCustom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:backgroundTint="@color/primary_sage"
                android:text="Rangkai Sekarang"
                android:textColor="@color/white"
                app:cornerRadius="20dp" />
        </RelativeLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>